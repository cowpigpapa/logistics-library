{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/library/ctu-code", "destination": "/library" },
    { "source": "/library/ctu-code/:id", "destination": "/library" },
    { "source": "/library/eu-lithium-battery", "destination": "/battery-library" },
    { "source": "/library/eu-lithium-battery/:id", "destination": "/battery-library" },
    { "source": "/library/dangerous-goods", "destination": "/dg-library" },
    { "source": "/library/dangerous-goods/:id", "destination": "/dg-library" }
  ],
  "headers": [
    {
      "source": "/dg-docs/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    },
    {
      "source": "/battery-docs/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    },
    {
      "source": "/ctu-library.js",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    },
    {
      "source": "/ctu-library.css",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    }
  ]
}
