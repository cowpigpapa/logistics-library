{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/library/ctu-code",
      "destination": "/library"
    },
    {
      "source": "/library/ctu-code/:id",
      "destination": "/library"
    },
    {
      "source": "/library/eu-lithium-battery",
      "destination": "/battery-library"
    },
    {
      "source": "/library/eu-lithium-battery/:id",
      "destination": "/battery-library"
    },
    {
      "source": "/library/dangerous-goods",
      "destination": "/dg-library"
    },
    {
      "source": "/library/dangerous-goods/:id",
      "destination": "/dg-library"
    },
    {
      "source": "/library/incoterms-2020",
      "destination": "/incoterms-library"
    },
    {
      "source": "/library/incoterms-2020/:id",
      "destination": "/incoterms-library"
    },
    {
      "source": "/library/air-uld",
      "destination": "/uld-library"
    },
    {
      "source": "/library/air-uld/:id",
      "destination": "/uld-library"
    },
    {
      "source": "/library/cargo-insurance",
      "destination": "/insurance-library"
    },
    {
      "source": "/library/cargo-insurance/:id",
      "destination": "/insurance-library"
    },
    {
      "source": "/library/bl-awb",
      "destination": "/bl-library"
    },
    {
      "source": "/library/bl-awb/:id",
      "destination": "/bl-library"
    },
    {
      "source": "/library/temperature-cargo",
      "destination": "/tc-library"
    },
    {
      "source": "/library/temperature-cargo/:id",
      "destination": "/tc-library"
    },
    {
      "source": "/library/charges",
      "destination": "/charges-library"
    },
    {
      "source": "/library/charges/:id",
      "destination": "/charges-library"
    },
    {
      "source": "/library/customs",
      "destination": "/customs-library"
    },
    {
      "source": "/library/customs/:id",
      "destination": "/customs-library"
    },
    {
      "source": "/library/container",
      "destination": "/container-library"
    },
    {
      "source": "/library/container/:id",
      "destination": "/container-library"
    }
  ],
  "headers": [
    {
      "source": "/search/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/cu-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/cn-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/term-review",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/ch-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/tc-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/bl-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/insurance-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/uld-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/incoterms-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/dg-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/battery-docs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/ctu-library.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    },
    {
      "source": "/ctu-library.css",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    }
  ],
  "functions": {
    "api/check-links.js": {
      "maxDuration": 90
    },
    "api/check-doc-links.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/check-links",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/check-doc-links",
      "schedule": "30 18 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/library-index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/airtracking",
      "missing": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/tool/airtracking",
      "permanent": true
    },
    {
      "source": "/containertracking",
      "missing": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/tool/containertracking",
      "permanent": true
    },
    {
      "source": "/unnumber",
      "missing": [
        {
          "type": "query",
          "key": "embed"
        }
      ],
      "destination": "/tool/unnumber",
      "permanent": true
    }
  ]
}
